# Normalize line endings so git stops warning "LF will be replaced by CRLF".
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.svg  text eol=lf
*.pdf  binary
*.xlsx binary
*.docx binary
*.zip  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary